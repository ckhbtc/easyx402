{
  "name": "easyx402",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:x402": "npm --prefix vendor/x402/packages/x402-injective install --no-package-lock --audit=false --fund=false && npm --prefix vendor/x402/packages/x402-injective run build",
    "dev": "npm run prepare:x402 && tsx src/index.ts",
    "build": "npm run prepare:x402 && tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@x402/injective": "file:vendor/x402/packages/x402-injective",
    "express": "^4.18.2"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
